# Koneksi database + kunci tanda tangan sesi admin + origin frontend yang diizinkan CORS
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio?sslmode=disable
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
WEB_ORIGIN=http://localhost:3000

# Object storage (MinIO/S3) tempat gambar, video, dan dokumen disimpan
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=portfolio
STORAGE_SECRET_KEY=replace-with-a-strong-storage-secret
STORAGE_BUCKET=portfolio

# Retensi file original. Setelah gambar/video selesai diproses, file mentahnya
# dihapus `cmd/worker` sesudah tenggang ini — semua pengiriman sudah memakai
# turunan di processed/. Original dokumen tidak pernah dihapus karena itulah
# file yang dilayani tombol download.
STORAGE_ORIGINAL_RETENTION=72h
STORAGE_RETENTION_SWEEP_INTERVAL=1h

# Akun admin untuk login ke /admin, dibuat lewat `make admin-upsert`. Password minimal 10 karakter.
ADMIN_EMAIL=admin@local.test
ADMIN_NAME="Portfolio Admin"
ADMIN_PASSWORD=replace-with-10-plus-characters

# Sandbox ImageMagick di worker. Dibaca proses `magick`, bukan kode Go —
# salah nilai berarti policy.xml diabaikan diam-diam tanpa error.
MAGICK_CONFIGURE_PATH=./config/imagemagick

# Pengiriman email form kontak. Boleh kosong di local, wajib saat APP_ENV=production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Integration test (`make test`). Wajib diisi — test yang env-nya kosong gagal,
# bukan di-skip, supaya tidak ada test yang diam-diam tidak pernah jalan.
# TEST_DATABASE_URL harus database terpisah: isinya ditulisi dan dihapus test.
# TEST_STORAGE_BUCKET dibuat dan dihapus oleh test, jadi jangan pakai bucket aplikasi.
TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio_test?sslmode=disable
TEST_STORAGE_ENDPOINT=localhost:9000
TEST_STORAGE_ACCESS_KEY=portfolio
TEST_STORAGE_SECRET_KEY=replace-with-a-strong-storage-secret
TEST_STORAGE_BUCKET=portfolio-test
